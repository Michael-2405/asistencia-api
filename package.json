{
	"name": "asistencia-api",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"main": "server.js",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/server.ts | pino-pretty",
		"build": "tsc && tsc-alias",
		"start": "tsx watch --env-file=.env src/server.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"ci": "biome ci .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"seed": "tsx --env-file=.env src/scripts/run-seed.ts"
	},
	"dependencies": {
		"better-auth": "^1.7.2",
		"cors": "^2.8.6",
		"drizzle-orm": "^0.45.2",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"pg": "^8.23.0",
		"pino": "^9.14.0",
		"pino-http": "^10.5.0",
		"resend": "^6.25.0",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.0",
		"pino-pretty": "^13.1.3",
		"tsc-alias": "^1.9.3",
		"tsx": "^4.23.12",
		"typescript": "^5.9.0"
	}
}
